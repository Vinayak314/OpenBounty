MONGODB_URI=mongodb://127.0.0.1:27017/openbounty
FIREBASE_PROJECT_ID=openbounty-b3e69
# Optional for local use. Otherwise configure Google Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
PORT=3000
CLIENT_ORIGINS=http://localhost:5173
# Serve the built client and API from the same origin.
SERVE_CLIENT=false

# --- Central AI (0G Private Computer, OpenAI-compatible router) ---
# Create a key at https://pc.0g.ai/dashboard/api-keys. Never commit it.
ZEROG_API_KEY=
ZEROG_BASE_URL=https://router-api.0g.ai/v1
ZEROG_MODEL=glm-5.2
# Leave empty: no "private" provider exists for glm-5.2 (live spike returned 503). Reasoning tokens count toward
# AI_MAX_OUTPUT_TOKENS (default 2500).
ZEROG_TRUST_MODE=
ZEROG_TIMEOUT_MS=60000
ZEROG_MAX_RETRIES=2
AI_ENABLED=true
AI_USER_RPM=4
AI_PROJECT_RPM=12
# Public, fixed-input judge demo. Limits apply per server process.
ZEROG_DEMO_ENABLED=false
ZEROG_DEMO_REQUESTS_PER_HOUR=24

# Optional: raises the GitHub API limit (60/h unauthenticated). Read-only public data; never commit it.
GITHUB_TOKEN=

# Optional automatic PR reviews. Set the same secret in the repository webhook.
# Only these comma-separated owner/repo names can trigger reviews or receive comments.
GITHUB_WEBHOOK_SECRET=
GITHUB_REVIEW_REPOSITORIES=
# Optional repository-scoped token with Pull requests: read/write to publish advisory comments.
# If GITHUB_TOKEN is empty, this token also authenticates GitHub read requests.
GITHUB_REVIEW_TOKEN=
# Rapid pushes to one PR collapse into one automatic review of the newest commit (milliseconds, max 60000).
REVIEW_DEBOUNCE_MS=5000
