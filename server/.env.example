MONGODB_URI=mongodb://127.0.0.1:27017/openbounty
FIREBASE_PROJECT_ID=openbounty-b3e69
# Optional for local use. Otherwise configure Google Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
PORT=3000
CLIENT_ORIGINS=http://localhost:5173
# Serve the built client and API from the same origin.
SERVE_CLIENT=false

# --- Central AI (0G Private Computer, OpenAI-compatible router) ---
# Create a key at https://pc.0g.ai/dashboard/api-keys. Never commit it.
ZEROG_API_KEY=
ZEROG_BASE_URL=https://router-api.0g.ai/v1
ZEROG_MODEL=glm-5.2
# Leave empty: no "private" provider exists for glm-5.2 (live spike returned 503). Reasoning tokens count toward
# AI_MAX_OUTPUT_TOKENS (default 2500).
ZEROG_TRUST_MODE=
ZEROG_TIMEOUT_MS=60000
ZEROG_MAX_RETRIES=2
AI_ENABLED=true
AI_USER_RPM=4
AI_PROJECT_RPM=12
# Public, fixed-input judge demo. Limits apply per server process.
ZEROG_DEMO_ENABLED=false
ZEROG_DEMO_REQUESTS_PER_HOUR=24

# Optional: raises the GitHub API limit (60/h unauthenticated). Read-only public data; never commit it.
GITHUB_TOKEN=

# Optional automatic PR reviews. Set the same secret in the repository webhook.
# Only these comma-separated owner/repo names can trigger reviews or receive comments.
GITHUB_WEBHOOK_SECRET=
GITHUB_REVIEW_REPOSITORIES=
# Optional repository-scoped token with Pull requests: read/write to publish advisory comments.
# If GITHUB_TOKEN is empty, this token also authenticates GitHub read requests.
GITHUB_REVIEW_TOKEN=
# Rapid pushes to one PR collapse into one automatic review of the newest commit (milliseconds, max 60000).
REVIEW_DEBOUNCE_MS=5000

# --- Whitechain payments (escrow + passkey accounts + gas sponsor) ---
# Payments turn on when ESCROW_ADDRESS, ACCOUNT_FACTORY_ADDRESS, SPONSOR_PRIVATE_KEY and ATTESTATION_PRIVATE_KEY are set.
PAYMENTS_ENABLED=true
WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
WHITECHAIN_CHAIN_ID=1874
WHITECHAIN_EXPLORER_URL=https://explorer.testnet.whitechain.io
# From contracts/deployments/*.json after deploying (see contracts/README.md).
ACCOUNT_FACTORY_ADDRESS=
ESCROW_ADDRESS=
# Block the escrow was deployed in; the indexer starts there.
ESCROW_DEPLOY_BLOCK=0
# Designated test USDT (default). Do not change on Whitechain Sepolia.
USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7
# Gas sponsor: a TEST key holding WBT. It pays fees only and has no authority in the escrow.
SPONSOR_PRIVATE_KEY=
# Attestation signer: a different TEST key whose address is the escrow's attestationSigner. Never reuse the sponsor key.
ATTESTATION_PRIVATE_KEY=
# Passkeys are bound to the site domain. Use the client's hostname (no scheme/port) and its exact origin(s).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:5173
# Sponsor abuse limits.
SPONSOR_USER_TX_PER_HOUR=12
SPONSOR_USER_TX_PER_DAY=40
SPONSOR_GLOBAL_TX_PER_HOUR=200
SPONSOR_MAX_GAS_PER_TX=2500000
# 0.5 WBT per day, pause below 0.02 WBT.
SPONSOR_DAILY_BUDGET_WEI=500000000000000000
SPONSOR_MIN_BALANCE_WEI=20000000000000000
# Largest sponsored bounty in USDT base units (10,000 USDT).
SPONSOR_MAX_BOUNTY_UNITS=10000000000
INDEXER_POLL_MS=15000
