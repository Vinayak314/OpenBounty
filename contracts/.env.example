# Copy to contracts/.env (git-ignored). Use TEST keys only: nothing here has monetary value.

# Deployer key for `npx hardhat run scripts/deploy.js --network whitechainSepolia`.
# Needs a little native test WBT for gas (https://faucet.testnet.whitechain.io). Never commit it.
PRIVATE_KEY=

# Repository/workspace owner wallet: manages maintainer/settlement roles and the signer/token
# allowlists. It is NOT a platform admin and cannot move escrowed funds. If it differs from the
# deployer, the owner must grant roles themselves after deployment.
OWNER_ADDRESS=

# Dedicated backend key that signs settlement/submission attestations. Must differ from the owner,
# the deployer and any AI-service credentials. Only the ADDRESS goes here; the private key stays
# in the backend's secret store.
ATTESTATION_SIGNER_ADDRESS=

# Optional comma-separated lists, applied only when the deployer is also the owner.
INITIAL_MAINTAINERS=
INITIAL_SETTLEMENT_WALLETS=

# Optional. On Whitechain Sepolia only the designated test USDT
# 0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7 is accepted; leave blank to use it.
TOKEN_ADDRESS=

# Optional overrides.
WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
# Blockscout does not require a key; the verify plugin just needs a non-empty string.
ETHERSCAN_API_KEY=
